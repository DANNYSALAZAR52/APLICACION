# Solo nombres de variables y placeholders NO funcionales. Copia a .env (ignorado por Git) y
# completa con valores propios. Nunca subas secretos reales.
#
# La demo actual (repositorios en memoria) no necesita ninguna de estas variables.
# Quedan listadas para cuando se active PostgreSQL (infra/docker-compose.yml, hoy comentado).

# --- PostgreSQL (pendiente) ---
PG_CONTROL_USER=<usuario-control>
PG_CONTROL_PASSWORD=<definir-secreto>
PG_TENANT_A_USER=<usuario-tenant-a>
PG_TENANT_A_PASSWORD=<definir-secreto>
PG_TENANT_B_USER=<usuario-tenant-b>
PG_TENANT_B_PASSWORD=<definir-secreto>

# --- Seguridad (pendiente: autenticación, fase 2) ---
JWT_SIGNING_KEY=<definir-secreto>
SECRETS_ENCRYPTION_KEY=<definir-secreto>   # cifra las cadenas de conexión de cada tenant
